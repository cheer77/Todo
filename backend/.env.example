# Environment variables for Appwrite relay server
# Copy this file to .env and fill in the values

# ─────────────────────────────────────────────────────────────────────
# Server Configuration
# ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Frontend URL for CORS (production)
FRONTEND_URL=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────
# Appwrite Configuration
# ─────────────────────────────────────────────────────────────────────

# Appwrite Cloud endpoint
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Your Appwrite project ID (from Appwrite Console → Settings → Project ID)
APPWRITE_PROJECT_ID=your-project-id-here

# Appwrite API Key with Database permissions
# Create from Appwrite Console → Settings → API Keys
# Make sure it has "databases.read", "databases.write", "database_documents.read", "database_documents.write", "database_documents.delete" scopes
APPWRITE_API_KEY=your-api-key-here

# Appwrite Database ID (where tasks are stored)
APPWRITE_DATABASE_ID=your-database-id-here

# Appwrite Collection ID (tasks collection)
APPWRITE_COLLECTION_ID=your-collection-id-here
